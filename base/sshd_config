# cbox base sshd config.
#
# Public-key only. Passwords and root login disabled. Authorized keys
# come from ~cbox/.ssh/authorized_keys, injected at runtime by cbox.

Port 22
AddressFamily any
ListenAddress 0.0.0.0
ListenAddress ::

PermitRootLogin no
PasswordAuthentication no
ChallengeResponseAuthentication no
KbdInteractiveAuthentication no
UsePAM no

PubkeyAuthentication yes
AuthorizedKeysFile %h/.ssh/authorized_keys

# Forward TERM + locale so tmux/dtach behave like a normal shell.
AcceptEnv LANG LC_*
PrintMotd no

# Port forwarding is needed for VSCode Remote-SSH (which tunnels its
# server port) and for `ssh -L` access to services running inside the
# tier. OSC 52 clipboard passthrough is in-band terminal escapes and
# does *not* require this — see plan.md §Host tmux.
AllowTcpForwarding yes
X11Forwarding no

Subsystem sftp /usr/lib/openssh/sftp-server
