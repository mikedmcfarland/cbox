{
  "sandbox": {
    "network": {
      "allowedDomains": [
        "api.anthropic.com",
        "github.com",
        "*.githubusercontent.com",
        "pypi.org",
        "registry.npmjs.org"
      ]
    },
    "allowUnsandboxedCommands": false
  },
  "permissions": {
    "allow": [
      "Read", "Edit", "Write", "Glob", "Grep",
      "Bash(git *)",
      "Bash(python *)", "Bash(pytest *)", "Bash(poetry *)", "Bash(uv *)",
      "Bash(npm *)", "Bash(node *)",
      "Bash(make test:*)", "Bash(make lint)", "Bash(make format)",
      "Bash(docker compose *)",
      "mcp__github__pull_request_read",
      "mcp__github__list_issues"
    ],
    "deny": [
      "Bash(gcloud secrets *)",
      "Bash(rm -rf /)"
    ]
  }
}
