{
  "sandbox": {
    "network": {
      "allowedDomains": [
        "api.anthropic.com",
        "github.com",
        "*.githubusercontent.com",
        "pypi.org",
        "registry.npmjs.org",
        "*.googleapis.com",
        "*.google.com"
      ]
    },
    "allowUnsandboxedCommands": false
  },
  "permissions": {
    "allow": [
      "Read", "Edit", "Write", "Glob", "Grep",
      "Bash(git *)",
      "Bash(python *)", "Bash(pytest *)", "Bash(poetry *)", "Bash(uv *)",
      "Bash(npm *)", "Bash(node *)",
      "Bash(make *)",
      "Bash(docker *)", "Bash(docker compose *)",
      "Bash(gh *)",
      "Bash(gcloud *)",
      "mcp__github__*"
    ],
    "deny": [
      "Bash(gcloud secrets delete *)",
      "Bash(gcloud projects delete *)"
    ]
  }
}
